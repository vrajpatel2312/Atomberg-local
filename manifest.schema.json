{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "project-graph graph file",
  "description": "Contract for the generated project graph file (Documentation/architecture/codebase-graph.json). Matches the template generator emitter (templates/project-graph/generator/project_graph.py SCHEMA_KEYS). Additive keys only: generators may add fields, never remove or rename existing ones. Stamps identifying the template build (project, template_version) live in the build manifest and graph.config.json, not in the graph file; the graph carries only generated_at/source_commit for freshness checks.",
  "type": "object",
  "additionalProperties": true,
  "required": ["nodes", "edges", "sources", "generated_at", "source_commit"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "source", "attrs"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "source": { "type": "string" },
          "attrs": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["src", "dst", "rel", "evidence"],
        "properties": {
          "src": { "type": "string" },
          "dst": { "type": "string" },
          "rel": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    },
    "gaps": { "type": "array" },
    "drift": { "type": "array" },
    "generated_at": { "type": "string" },
    "source_commit": { "type": "string" }
  }
}
